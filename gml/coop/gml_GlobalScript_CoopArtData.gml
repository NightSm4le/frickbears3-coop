// ===== 0.6.3: draft co-op art embedded in data.win (generated from coop_art/*.png by scripts/gen_artdata.py) =====
// coop_art_get() uses these when <game>/coop_art/<key>.png is missing (the tester had no coop_art folder in 0.6.2).
function coop_art_embedded(_key)
{
    switch (_key)
    {
        case "P1_bonnie_bill": return "";
        case "P1_bonnie_icon": return "";
        case "P1_bonnie_portrait": return "";
        case "P1_chica_bill": return "";
        case "P1_chica_icon": return "";
        case "P1_chica_portrait": return "";
        case "P1_freddy_bill": return "";
        case "P1_freddy_icon": return "";
        case "P1_freddy_portrait": return "";
        case "P2_bonnie_bill": return "";
        case "P2_bonnie_icon": return "";
        case "P2_bonnie_portrait": return "";
        case "P2_chica_bill": return "";
        case "P2_chica_icon": return "";
        case "P2_chica_portrait": return "";
        case "P2_freddy_bill": return "";
        case "P2_freddy_icon": return "";
        case "P2_freddy_portrait": return "";
    }
    return "";
}
