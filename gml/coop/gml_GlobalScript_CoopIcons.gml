// generated by art/icons.py
function coop_icon_rows(_n)
{
    switch (_n)
    {
        case "warn": return [".......K.......", "......KWK......", "......KWK......", ".....KWWWK.....", ".....KWRWK.....", "....KWWRWWK....", "....KWWRWWK....", "...KWWWRWWWK...", "...KWWWWWWWK...", "..KWWWWRWWWWK..", "..KWWWWWWWWWK..", ".KKKKKKKKKKKKK."];
        case "vent": return [".KKKKKKKKKKKKK.", ".KWWWWWWWWWWWK.", ".KWKKKKKKKKKWK.", ".KWWWWWRWWWWWK.", ".KWKKKKRKKKKWK.", ".KWWWWWRWWWWWK.", ".KWKKKKKKKKKWK.", ".KWWWWWRWWWWWK.", ".KWKKKKKKKKKWK.", ".KWWWWWWWWWWWK.", ".KKKKKKKKKKKKK."];
        case "note": return ["....KKKKKKK..", "....KWWWWWK..", "....KKKKKWK..", "....KW..KWK..", "....KW..KWK..", "..KKKW.KKWK..", ".KWWWK.KWWK..", ".KWWWK..KK...", "..KKK.....RR.", "..........RR.", "...........R."];
        case "check": return ["........KK.", ".......KGK.", "KK....KGK..", "KGK..KGK...", ".KGKKGK....", "..KGGK.....", "...KK......"];
        case "chevL": return ["...KK", "..KRK", ".KRK.", "KRK..", ".KRK.", "..KRK", "...KK"];
        case "pin": return ["..KKKKK..", ".KOOOOOK.", "KOOHHOOOK", "KOOHHOOOK", "KOOOOOOOK", ".KOOOOOK.", "..KOOOK..", "...KOK...", "....K...."];
        case "door": return ["KKKKKKKKK", "KWWWWWWWK", "KWKKKKKWK", "KWKWWWKWK", "KWKWWWKWK", "KWKKKKKWK", "KWWWWWRWK", "KWWWWWWWK", "KWWWWWWWK", "KKKKKKKKK"];
    }
    return [];
}
